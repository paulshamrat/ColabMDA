#!/usr/bin/env bash
set -euo pipefail
if [[ "$(git config --bool --get colabmda.privateCheckout || true)" == true ]]; then
  echo "This private research checkout cannot push. Publish a reviewed clean snapshot separately." >&2
  exit 1
fi
scanner="$(git config --get colabmda.gitleaksPath || true)"
scanner="${scanner:-gitleaks}"
command -v "$scanner" >/dev/null || { echo "Install Gitleaks before pushing; see CONTRIBUTING.md" >&2; exit 1; }

# Formatting, linting and syntax pre-push checks (CI Parity)
black_bin="$(command -v black || true)"
if [[ -z "$black_bin" && -x "/home/paul/miniforge3/envs/cmda/bin/black" ]]; then
  black_bin="/home/paul/miniforge3/envs/cmda/bin/black"
elif [[ -z "$black_bin" && -x "/home/paul/miniforge3/bin/black" ]]; then
  black_bin="/home/paul/miniforge3/bin/black"
fi

ruff_bin="$(command -v ruff || true)"
if [[ -z "$ruff_bin" && -x "/home/paul/miniforge3/envs/cmda/bin/ruff" ]]; then
  ruff_bin="/home/paul/miniforge3/envs/cmda/bin/ruff"
elif [[ -z "$ruff_bin" && -x "/home/paul/miniforge3/bin/ruff" ]]; then
  ruff_bin="/home/paul/miniforge3/bin/ruff"
fi

if [[ -n "$black_bin" ]]; then
  "$black_bin" --check . || {
    echo "ERROR: Black formatting check failed. Run '$black_bin .' to auto-format before pushing." >&2
    exit 1
  }
fi

if [[ -n "$ruff_bin" ]]; then
  "$ruff_bin" check . || {
    echo "ERROR: Ruff lint check failed. Fix lint issues before pushing." >&2
    exit 1
  }
fi

find examples scripts .githooks -type f \( -name '*.sh' -o -name '*.slurm' -o -name 'pre-commit' -o -name 'pre-push' \) -exec bash -n {} \;

if [[ ! -t 0 ]]; then
  has_input=false
  while read -r local_ref local_sha remote_ref remote_sha; do
    has_input=true
    if [[ "$local_sha" != "0000000000000000000000000000000000000000" ]]; then
      if [[ "$remote_sha" != "0000000000000000000000000000000000000000" ]]; then
        range="${remote_sha}..${local_sha}"
      else
        range="${local_sha}"
      fi
      "$scanner" git --log-opts="$range" --redact=100 --no-banner --config .gitleaks.toml .
    fi
  done
  if [[ "$has_input" == false ]]; then
    "$scanner" git --log-opts="HEAD" --redact=100 --no-banner --config .gitleaks.toml .
  fi
else
  "$scanner" git --log-opts="HEAD" --redact=100 --no-banner --config .gitleaks.toml .
fi
